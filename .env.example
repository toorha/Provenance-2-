# Request Access. Copy to .env.local and fill in. Never commit real values.

# Supabase ------------------------------------------------------------------
# Project URL. Safe to expose: it is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. SERVER ONLY. It bypasses row level security, so anything
# holding it can read and write every table. It must never appear in a client
# component, a NEXT_PUBLIC_ variable, or a commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend --------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key

# Where the internal notification goes.
REQUEST_ACCESS_NOTIFICATION_EMAIL=you@yourdomain.com

# Who it comes from. The domain must be verified in Resend first. Before you
# have verified one, Resend's shared sender works for testing:
#   Provenance <onboarding@resend.dev>
# It can only deliver to the address that owns the Resend account.
REQUEST_ACCESS_FROM_EMAIL=Provenance <access@yourdomain.com>
